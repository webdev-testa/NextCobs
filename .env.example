# Google AI Studio / Gemini API Configuration
# Get your free API key at https://aistudio.google.com/
# The chatbot uses the free tier with automated multi-model fallback across:
# gemini-3.8-flash -> gemini-3.7-flash -> gemini-3.6-flash -> gemini-3.5-flash-lite -> gemini-3.5-flash -> gemini-3.1-flash-lite -> gemini-3-flash (with 2.5/2.0 trailing safety fallback)
GEMINI_API_KEY="your-gemini-api-key-here"

# (Optional) Custom fallback models order (comma-separated):
# GEMINI_MODELS="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash"

# Turso Database Configuration (for sticky notes)
# Obtain these from https://turso.tech (create a free account -> new database)
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"
